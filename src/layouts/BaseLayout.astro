---
import '../styles/global.css';
import LanguageSwitch from '@/components/LanguageSwitch.astro';
import type { SiteLang } from '@/lib/blog';

interface Props {
  title: string;
  description?: string;
  lang?: SiteLang;
  zhHref?: string;
  enHref?: string;
  showLanguageSwitch?: boolean;
}
const {
  title,
  description = 'Jacky Ren 的双语个人博客，记录软件、产品与学习。',
  lang = 'zh',
  zhHref,
  enHref,
  showLanguageSwitch = true,
} = Astro.props;
const pageTitle = title === 'Jacky Ren' ? title : `${title} · Jacky Ren`;
---
<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-lang={lang}>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Jacky Ren home"><span class="brand-mark">JR</span><span>Jacky Ren</span></a>
        <div class="header-actions">
          <nav aria-label="Main navigation"><a href="/blog/">Blog</a><a href="/#about">About</a></nav>
          {showLanguageSwitch && <LanguageSwitch current={lang} zhHref={zhHref} enHref={enHref} />}
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <p><span lang="zh">用 Astro 构建：快、轻、适合长期写作。</span><span lang="en">Built with Astro for fast, durable writing.</span></p>
        <a href="/blog/"><span lang="zh">阅读归档 →</span><span lang="en">Read the archive →</span></a>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const storageKey = 'jackyren-lang';
        const valid = new Set(['zh', 'en']);
        const pathLang = location.pathname.match(/^\/blog\/(zh|en)\//)?.[1];
        const stored = localStorage.getItem(storageKey);
        const initial = valid.has(pathLang) ? pathLang : valid.has(stored) ? stored : document.documentElement.dataset.lang || 'zh';
        function setLang(lang) {
          if (!valid.has(lang)) return;
          document.documentElement.dataset.lang = lang;
          document.documentElement.lang = lang;
          document.body.dataset.lang = lang;
          localStorage.setItem(storageKey, lang);
          document.querySelectorAll('[data-set-lang]').forEach((button) => {
            button.classList.toggle('is-active', button.dataset.setLang === lang);
          });
        }
        document.addEventListener('click', (event) => {
          const button = event.target.closest?.('[data-set-lang]');
          if (!button) return;
          setLang(button.dataset.setLang);
        });
        setLang(initial);
      })();
    </script>
  </body>
</html>
