---
import type { CollectionEntry } from 'astro:content';
import { languageRole, postUrl } from '@/lib/blog';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const locale = post.data.lang === 'zh' ? 'zh-CN' : 'en';
const date = post.data.pubDate.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' });
const role = languageRole(post);
---
<article class="post-card" data-post-lang={post.data.lang}>
  <div class="post-card__meta">
    <time datetime={post.data.pubDate.toISOString()}>{date}</time>
    <span>{post.data.lang.toUpperCase()} · {role}</span>
  </div>
  <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="post-card__footer">
    {post.data.tags.length > 0 && <span class="mini-tag">{post.data.tags[0]}</span>}
    <a class="read-more" href={postUrl(post)}>{post.data.lang === 'zh' ? '阅读 →' : 'Read →'}</a>
  </div>
</article>
