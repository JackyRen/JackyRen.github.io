---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { groupByCanonical, sortPosts } from '@/lib/blog';

const allPosts = sortPosts((await getCollection('blog')).filter((post) => !post.data.draft));
const grouped = Object.values(groupByCanonical(allPosts));
const zhPosts = allPosts.filter((post) => post.data.lang === 'zh');
const enPosts = allPosts.filter((post) => post.data.lang === 'en');
---
<BaseLayout title="Blog" description="Jacky Ren 的中英文博客归档。">
  <section class="page-heading">
    <p class="eyebrow">Archive / 归档</p>
    <h1>Blog</h1>
    <p class="lang-panel" data-lang-panel="zh" lang="zh">所有文章都保留原文语言与译文关系。你可以切换语言，也可以在每篇文章里跳转到对应译本。</p>
    <p class="lang-panel" data-lang-panel="en" lang="en">Every post records its original language and translation relationship. Switch languages here, or jump between versions inside each article.</p>
  </section>
  <section class="post-list post-list--archive lang-panel" data-lang-panel="zh" lang="zh" aria-label="中文文章">{zhPosts.map((post) => <PostCard post={post} />)}</section>
  <section class="post-list post-list--archive lang-panel" data-lang-panel="en" lang="en" aria-label="English posts">{enPosts.map((post) => <PostCard post={post} />)}</section>
  <section class="translation-map" aria-labelledby="translation-map-heading">
    <p class="eyebrow">Metadata</p>
    <h2 id="translation-map-heading">Originals and translations</h2>
    <div class="translation-map__grid">
      {grouped.map((posts) => (
        <article>
          <strong>{posts[0].data.canonicalId}</strong>
          <ul>{posts.map((post) => <li>{post.data.lang.toUpperCase()}: {post.data.title} · original: {post.data.originalLang.toUpperCase()}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
