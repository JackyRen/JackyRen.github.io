---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import TagCloud from '@/components/TagCloud.astro';
import { collectTagStats, sortPosts } from '@/lib/blog';

const allPosts = sortPosts((await getCollection('blog')).filter((post) => !post.data.draft));
const zhPosts = allPosts.filter((post) => post.data.lang === 'zh').slice(0, 3);
const enPosts = allPosts.filter((post) => post.data.lang === 'en').slice(0, 3);
const tagStats = collectTagStats(allPosts, 14);
---
<BaseLayout title="Jacky Ren" description="Jacky Ren 的双语个人博客：软件、产品、系统与学习笔记。">
  <section class="hero">
    <div class="hero__copy">
      <div class="lang-panel" data-lang-panel="zh" lang="zh">
        <p class="eyebrow">Personal OS / 双语博客</p>
        <h1>在系统与现实之间，写一点清醒的笔记。</h1>
        <p class="hero-copy">这里是 Jacky Ren 的个人主页：记录软件工程、产品判断、自动化工作流，以及长期学习中值得复用的思考。界面保持克制，底层保持可迁移，内容用中英双语慢慢沉淀。</p>
        <div class="hero-actions"><a class="button" href="/blog/">进入博客</a><a class="button button--secondary" href="#topics">浏览关键词</a></div>
      </div>
      <div class="lang-panel" data-lang-panel="en" lang="en">
        <p class="eyebrow">Personal OS / Bilingual notes</p>
        <h1>Clear notes between systems and reality.</h1>
        <p class="hero-copy">A minimal home for Jacky Ren’s writing on software, product taste, automation workflows, and durable learning. The site is intentionally quiet, portable, and bilingual from the start.</p>
        <div class="hero-actions"><a class="button" href="/blog/">Read the blog</a><a class="button button--secondary" href="#topics">Browse topics</a></div>
      </div>
    </div>
    <TagCloud tags={tagStats} title="Topic radar" subtitle="文章里的高频主题会自动汇聚成标签云，帮助读者先看方向再进归档。" lang="zh" compact />
  </section>
  <section id="topics" class="topic-band" aria-labelledby="topic-band-heading">
    <div>
      <p class="eyebrow">Information architecture</p>
      <h2 id="topic-band-heading"><span lang="zh">从关键词进入内容</span><span lang="en">Navigate by topic</span></h2>
    </div>
    <p class="lang-panel" data-lang-panel="zh" lang="zh">标签云按文章出现频次建立视觉层级：高频主题更大、更深，低频主题保持轻量，避免归档页只有时间线。</p>
    <p class="lang-panel" data-lang-panel="en" lang="en">The cloud sizes topics by post frequency, giving repeat themes stronger visual weight without replacing the chronological archive.</p>
  </section>
  <section class="section-grid" aria-labelledby="latest-posts">
    <div>
      <p class="eyebrow"><span lang="zh">最新文章</span><span lang="en">Latest writing</span></p>
      <h2 id="latest-posts"><span lang="zh">Recent notes</span><span lang="en">Recent notes</span></h2>
    </div>
    <div class="post-list lang-panel" data-lang-panel="zh" lang="zh">{zhPosts.map((post) => <PostCard post={post} />)}</div>
    <div class="post-list lang-panel" data-lang-panel="en" lang="en">{enPosts.map((post) => <PostCard post={post} />)}</div>
  </section>
  <section id="about" class="about-card" aria-labelledby="about-heading">
    <div><p class="eyebrow">About</p><h2 id="about-heading">Jacky Ren</h2></div>
    <div class="lang-panel" data-lang-panel="zh" lang="zh"><p>我是 Jacky Ren，软件工程师，长期关注系统、质量、自动化和 AI agent。</p><p>我喜欢把复杂问题做成可验证、可维护、能长期使用的工具。</p><p>这个站点记录我的工程实践、agent 工作流、产品判断和学习笔记。</p></div>
    <div class="lang-panel" data-lang-panel="en" lang="en"><p>I’m Jacky Ren, a software engineer interested in systems, quality, automation, and AI agents.</p><p>I like turning messy problems into tools that are verifiable, maintainable, and useful over time.</p><p>This site collects my engineering notes, agent workflow experiments, product thinking, and learning logs.</p></div>
  </section>
</BaseLayout>
